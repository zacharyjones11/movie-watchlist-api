# Paste your existing cluster connection string here, with its database password.
# Never commit your real .env file.
MONGODB_URI=
# Explicitly selects the NEW database, even if the URI names your old database.
MONGODB_DB_NAME=movie_watchlist
PORT=8081
# Generate a private value with: openssl rand -base64 48
SESSION_SECRET=
# Create a GitHub OAuth App with this exact callback URL for local development.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8081/auth/github/callback
# Optional comma-separated origins for a separate browser frontend.
CORS_ORIGINS=
