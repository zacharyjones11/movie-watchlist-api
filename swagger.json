{
  "openapi": "3.0.3",
  "info": {
    "title": "Movie Watchlist API",
    "version": "1.0.0",
    "description": "CSE 341 Project 2 — sign in with GitHub, then manage your private movie watchlist and reviews. Open /auth/github in a browser to sign in. Movie and review routes require your session; POST, PUT, and DELETE also require the X-CSRF-Token from GET /auth/me. Users can only see and change their own documents. Create a movie before posting a review, using its returned _id as movieId. Requests and responses use JSON. PUT requires every input field."
  },
  "servers": [
    {
      "url": "/",
      "description": "The server hosting this documentation"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth sign-in, current user, and logout"
    },
    {
      "name": "Movies",
      "description": "Movie details and watchlist status"
    },
    {
      "name": "Reviews",
      "description": "Reviews linked to existing movies"
    },
    {
      "name": "System",
      "description": "Service information and database health"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getInfo",
        "summary": "API information",
        "responses": {
          "200": {
            "description": "API name, links, and sign-in instructions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "documentation": {
                      "type": "string"
                    },
                    "movies": {
                      "type": "string"
                    },
                    "reviews": {
                      "type": "string"
                    },
                    "authentication": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Check MongoDB connectivity",
        "responses": {
          "200": {
            "description": "Database responds to ping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "startGithubLogin",
        "summary": "Sign in with GitHub",
        "description": "Open this route in a browser. On successful sign-in, GitHub returns to the callback and the API redirects to Swagger UI. OAuth state is validated to prevent login CSRF.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub authorization"
          },
          "503": {
            "description": "GitHub OAuth is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "githubCallback",
        "summary": "GitHub OAuth callback",
        "description": "Completes the authorization-code exchange, upserts the GitHub user, rotates the session, and redirects to Swagger UI.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Sign-in succeeded; redirects to /api-docs/"
          },
          "400": {
            "description": "Invalid or expired OAuth state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in was cancelled or rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Sign-in could not be completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "getCurrentUser",
        "summary": "Get the signed-in user and CSRF token",
        "description": "Requires a signed-in browser session. Copy csrfToken into the X-CSRF-Token authorization field before running POST, PUT, or DELETE requests in Swagger.",
        "responses": {
          "200": {
            "description": "Signed-in GitHub profile and session CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "logout",
        "summary": "Sign out",
        "description": "Requires a signed-in session and the X-CSRF-Token returned by GET /auth/me.",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session deleted and cookie cleared"
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid X-CSRF-Token header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/movies": {
      "get": {
        "tags": [
          "Movies"
        ],
        "operationId": "listMovies",
        "summary": "List movies",
        "description": "Requires GitHub sign-in. The authenticated session only sees this user's documents. Returns an array ordered by document ID. Unknown query parameters are rejected.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "watchStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "want-to-watch",
                "watching",
                "watched"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching documents (empty array if none)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "operationId": "createMovie",
        "summary": "Create a movie",
        "description": "Requires GitHub sign-in and the X-CSRF-Token returned by GET /auth/me. The server sets userId; all input fields are required and extra fields are rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              },
              "example": {
                "title": "The Incredibles",
                "releaseYear": 2004,
                "genre": "Animation",
                "director": "Brad Bird",
                "runtimeMinutes": 115,
                "contentRating": "PG",
                "synopsis": "A family of superheroes returns to action.",
                "watchStatus": "want-to-watch"
              }
            }
          }
        },
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created document",
            "headers": {
              "Location": {
                "description": "Relative URL of the created document",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid X-CSRF-Token header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 100 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/movies/{id}": {
