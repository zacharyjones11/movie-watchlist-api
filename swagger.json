  "components": {
    "schemas": {
      "MovieInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "releaseYear": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "genre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "director": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "runtimeMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "contentRating": {
            "type": "string",
            "enum": [
              "G",
              "PG",
              "PG-13",
              "R",
              "NC-17",
              "NR"
            ]
          },
          "synopsis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "watchStatus": {
            "type": "string",
            "enum": [
              "want-to-watch",
              "watching",
              "watched"
            ]
          }
        },
        "required": [
          "title",
          "releaseYear",
          "genre",
          "director",
          "runtimeMinutes",
          "contentRating",
          "synopsis",
          "watchStatus"
        ],
        "additionalProperties": false,
        "example": {
          "title": "The Incredibles",
          "releaseYear": 2004,
          "genre": "Animation",
          "director": "Brad Bird",
          "runtimeMinutes": 115,
          "contentRating": "PG",
          "synopsis": "A family of superheroes returns to action.",
          "watchStatus": "want-to-watch"
        }
      },
      "ReviewInput": {
        "type": "object",
        "properties": {
          "movieId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "reviewerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "reviewText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "watchedOn": {
            "type": "string",
            "format": "date"
          },
          "containsSpoilers": {
            "type": "boolean"
          }
        },
