            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Reviews"
        ],
        "operationId": "updateReview",
        "summary": "Update a review",
        "description": "Send all input fields, including unchanged fields. The original ID and createdAt are preserved; updatedAt is set by the server. Does not create a missing document.",
        "requestBody": {
