                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "operationId": "updateMovie",
        "summary": "Update a movie",
        "description": "Requires GitHub sign-in and the X-CSRF-Token returned by GET /auth/me. Send all input fields, including unchanged fields. The original ID, owner, and createdAt are preserved; updatedAt is set by the server. Does not create a missing document.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              },
              "example": {
                "title": "The Incredibles",
                "releaseYear": 2004,
                "genre": "Animation",
                "director": "Brad Bird",
                "runtimeMinutes": 115,
                "contentRating": "PG",
                "synopsis": "A family of superheroes returns to action.",
                "watchStatus": "want-to-watch"
              }
            }
          }
        },
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid X-CSRF-Token header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document or referenced movie not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 100 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "operationId": "deleteMovie",
        "summary": "Delete a movie",
        "description": "Requires GitHub sign-in and the X-CSRF-Token returned by GET /auth/me. Delete your associated reviews first. A movie with reviews returns 409.",
        "security": [
          {
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted successfully; no response body"
          },
          "400": {
            "description": "Invalid path, query, or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid X-CSRF-Token header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Movie still has reviews",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "operationId": "listReviews",
        "summary": "List reviews",
        "description": "Requires GitHub sign-in. The authenticated session only sees this user's documents. Returns an array ordered by document ID. Unknown query parameters are rejected.",
